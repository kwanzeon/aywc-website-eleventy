---
layout: base.njk
title: "Organizations"
navPage: "organizations"
permalink: "/organizations/index.html"
metaDescription: "Agni Yoga organizations worldwide — societies, museums, and educational institutions dedicated to the Living Ethics teachings."
---

<header>
  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label on-dark">Global Network</div>
      <h1 class="page-hero-title">Organizations</h1>
      <p class="page-hero-subtitle">Societies, museums, and educational institutions around the world dedicated to the Agni Yoga (Living Ethics) teachings.</p>
      <div class="page-hero-line"></div>
    </div>
  </div>
</header>

<main id="main-content" style="background:var(--bg);padding:4rem 3rem;">
  <div style="max-width:1200px;margin:0 auto;">

    <div class="region-filter" role="group" aria-label="Filter by region">
      <button class="region-btn active" data-region="All" aria-pressed="true">All</button>
      <button class="region-btn" data-region="Americas" aria-pressed="false">Americas</button>
      <button class="region-btn" data-region="Europe" aria-pressed="false">Europe</button>
      <button class="region-btn" data-region="Asia-Pacific" aria-pressed="false">Asia-Pacific</button>
    </div>

    <h2 class="sr-only">Organizations list</h2>
    <p class="sr-only" aria-live="polite" aria-atomic="true" id="orgs-filter-status"></p>

    <div class="card-grid card-grid-2" id="orgs-list">
      {% for org in collections.organizations %}
      <div class="card" data-region="{{ org.data.region if org.data.region else 'Other' }}">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
          <h3>{{ org.data.title }}</h3>
          {% if org.data.established %}<span class="group-card-format">Est. {{ org.data.established }}</span>{% endif %}
        </div>
        <div class="group-card-meta">
          <span class="group-card-location">{{ org.data.location }}</span>
        </div>
        <p>{{ org.data.description }}</p>
        {% if org.data.website %}
        <div style="margin-top:1rem;">
          <a href="{{ org.data.website }}" target="_blank" rel="noopener" class="card-link">Visit website &rarr;</a>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    {% if collections.organizations.length == 0 %}
    <p style="text-align:center;color:var(--text-muted);padding:4rem 0;">No organizations listed yet.</p>
    {% endif %}

  </div>
</main>

<script>
  const btns = document.querySelectorAll('.region-btn');
  const cards = document.querySelectorAll('#orgs-list .card');
  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      const region = btn.dataset.region;
      let visible = 0;
      cards.forEach(card => {
        const show = region === 'All' || card.dataset.region === region;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      const status = document.getElementById('orgs-filter-status');
      if (status) status.textContent = region === 'All' ? 'Showing all organizations.' : 'Showing ' + visible + ' organization' + (visible !== 1 ? 's' : '') + ' in ' + region + '.';
    });
  });
</script>
