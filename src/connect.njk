---
layout: base.njk
title: "Connect"
navPage: "connect"
permalink: "/connect/index.html"
metaDescription: "Get in touch with the Agni Yoga World Community. Register your study group, submit news, contribute resources, or volunteer."
---

<header>
  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label on-dark">Open to All</div>
      <h1 class="page-hero-title">Connect</h1>
      <p class="page-hero-subtitle">The Agni Yoga World Community is volunteer-run with no formal membership or hierarchy. Whether you are new to the Teachings or an experienced student, you are welcome here.</p>
      <div class="page-hero-line"></div>
    </div>
  </div>
</header>

<main id="main-content" class="form-section">
  <div style="max-width:1200px;margin:0 auto;">
    <div class="form-grid">

      <div>
        <h2 class="section-heading" style="margin-bottom:1.5rem;">Ways to get involved</h2>
        {% for item in ["Connect with an existing local study group", "Register your own group or organization in the directory", "Contribute resources, translations, or articles", "Submit news, events, and announcements"] %}
        <div class="join-item" style="margin-bottom:0.9rem;">
          <span style="color:var(--accent);margin-top:3px;flex-shrink:0;font-size:0.7rem;">✦</span>
          <span style="color:var(--text-muted);font-size:1rem;font-weight:400;line-height:1.6;">{{ item }}</span>
        </div>
        {% endfor %}
      </div>

      <div>
        <div class="section-label">Contact Us</div>
        <h2 class="section-heading" style="margin-bottom:1.5rem;">Get in Touch</h2>
        <form name="contact" method="POST" action="/thank-you/" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required aria-required="true" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="your@email.com" required aria-required="true" />
          </div>
          <div class="field">
            <label for="reason">Reason for contact</label>
            <select id="reason" name="reason">
              <option value="">Select one&hellip;</option>
              <option>General inquiry</option>
              <option>Register a study group or organization</option>
              <option>Submit news or event</option>
              <option>Contribute resources</option>
              <option>Volunteering</option>
            </select>
          </div>
          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Your message&hellip;" required aria-required="true"></textarea>
          </div>
          <button class="btn btn-primary" type="submit">Send Message</button>
        </form>
      </div>

    </div>
  </div>
</main>
