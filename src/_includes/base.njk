      <div class="footer-grid">
        <div>
          <div class="footer-brand">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="14" height="14" fill="currentColor" style="opacity:0.6;vertical-align:middle;margin-right:0.5rem;" aria-hidden="true">
              <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1.25"/>
              <circle cx="20" cy="10.5" r="4"/>
              <circle cx="12" cy="26" r="4"/>
              <circle cx="28" cy="26" r="4"/>
            </svg>AYWC
          </div>
          <p class="footer-tagline">Connecting students of the Living Ethics teachings worldwide.</p>
          <div class="footer-operator">White Mountain Education Association, Inc.</div>
        </div>
        <div class="footer-col">
          <h2 class="footer-col-heading">Learn</h2>
          <a href="/what-is-agni-yoga/" class="on-dark">What is Agni Yoga?</a>
