<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }}—{{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ metaDescription if metaDescription else site.description }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }}—{{ site.name }}{% else %}{{ site.name }}{% endif %}" />
  <meta property="og:description" content="{{ metaDescription if metaDescription else site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/assets/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }}—{{ site.name }}{% else %}{{ site.name }}{% endif %}" />
  <meta name="twitter:description" content="{{ metaDescription if metaDescription else site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}/assets/og-image.png" />
  <link rel="stylesheet" href="/assets/css/fonts.css?v=20260705" />
  <link rel="stylesheet" href="/assets/css/style.css?v=20260831" />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon-180.png" />
  <script src="/assets/js/identity-redirect.js?v=20260705"></script>
  <noscript>
    <style>
      /* Without JS the nav toggle can't work — show the links instead. */
      @media (max-width: 700px) {
        .nav-links { display: flex !important; flex-direction: column; width: 100%; padding: 0.5rem 0; }
        .nav-toggle { display: none !important; }
      }
    </style>
  </noscript>
</head>
<body>

  <a class="skip-link" href="#main-content">Skip to main content</a>

  <nav aria-label="Main navigation">
    <div class="nav-inner">
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="nav-links">
        <a href="/" class="on-dark{% if navPage == 'home' %} active{% endif %}"{% if navPage == 'home' %} aria-current="page"{% endif %}>Home</a>
        <a href="/about/" class="on-dark{% if navPage == 'about' %} active{% endif %}"{% if navPage == 'about' %} aria-current="page"{% endif %}>About</a>
        <a href="/news/" class="on-dark{% if navPage == 'news' %} active{% endif %}"{% if navPage == 'news' %} aria-current="page"{% endif %}>News &amp; Events</a>
        <a href="/community/" class="on-dark{% if navPage == 'community' %} active{% endif %}"{% if navPage == 'community' %} aria-current="page"{% endif %}>Community</a>
        <a href="/resources/" class="on-dark{% if navPage == 'resources' %} active{% endif %}"{% if navPage == 'resources' %} aria-current="page"{% endif %}>Resources</a>
        <a href="/seed-thoughts/" class="on-dark{% if navPage == 'seed-thoughts' %} active{% endif %}"{% if navPage == 'seed-thoughts' %} aria-current="page"{% endif %}>Seed Thoughts</a>
        <a href="/connect/" class="on-dark{% if navPage == 'connect' %} active{% endif %}"{% if navPage == 'connect' %} aria-current="page"{% endif %}>Connect</a>
        <a href="/forum/" class="on-dark{% if navPage == 'forum' %} active{% endif %}"{% if navPage == 'forum' %} aria-current="page"{% endif %}>Forum</a>
      </div>
    </div>
  </nav>

  {{ content | safe }}

  <footer role="contentinfo">
