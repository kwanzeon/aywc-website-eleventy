<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ metaDescription if metaDescription else site.description }}" />
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
  <meta property="og:description" content="{{ metaDescription if metaDescription else site.description }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.url }}/assets/og-image.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }}{% endif %}" />
  <meta name="twitter:description" content="{{ metaDescription if metaDescription else site.description }}" />
  <meta name="twitter:image" content="{{ site.url }}/assets/og-image.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Cinzel:wght@400;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/style.css" />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <script>
    (function() {
      var h = window.location.hash;
      if (h && (h.indexOf('invite_token=') > -1 || h.indexOf('recovery_token=') > -1 || h.indexOf('confirmation_token=') > -1)) {
        window.location.replace('/admin/' + h);
      }
    })();
  </script>
</head>
<body>

  <a class="skip-link" href="#main-content">Skip to main content</a>

  <nav aria-label="Main navigation">
    <div class="nav-inner">
      <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="nav-links">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="nav-links">
        <a href="/" class="on-dark{% if navPage == 'home' %} active{% endif %}">Home</a>
        <a href="/about/" class="on-dark{% if navPage == 'about' %} active{% endif %}">About</a>
        <a href="/news/" class="on-dark{% if navPage == 'news' %} active{% endif %}">News &amp; Events</a>
        <a href="/community/" class="on-dark{% if navPage == 'community' %} active{% endif %}">Community</a>
        <a href="/resources/" class="on-dark{% if navPage == 'resources' %} active{% endif %}">Resources</a>
        <a href="/connect/" class="on-dark{% if navPage == 'connect' %} active{% endif %}">Connect</a>
      </div>
    </div>
  </nav>

  {{ content | safe }}

  <footer role="contentinfo">
    <div class="footer-inner">
      <div class="footer-grid">
        <div>
          <div class="footer-brand">AYWC</div>
          <p class="footer-tagline">Connecting students of the Living Ethics teachings worldwide.</p>
          <div class="footer-operator">White Mountain Education Association</div>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Learn</div>
          <a href="/what-is-agni-yoga/" class="on-dark">What is Agni Yoga?</a>
          <a href="/about/" class="on-dark">About Agni Yoga</a>
          <a href="/about/#teachings" class="on-dark">The Teachings</a>
          <a href="/about/#roerich" class="on-dark">Nicholas Roerich</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Community</div>
          <a href="/community/" class="on-dark">Community</a>
          <a href="/news/" class="on-dark">News &amp; Events</a>
          <a href="/connect/" class="on-dark">Connect</a>
        </div>
        <div class="footer-col">
          <div class="footer-col-heading">Resources</div>
          <a href="/resources/" class="on-dark">All Resources</a>
          <a href="https://www.agniyoga.org/" class="on-dark" target="_blank" rel="noopener">Agni Yoga Series</a>
          <a href="https://www.roerich.org/index.php" class="on-dark" target="_blank" rel="noopener">Roerich Paintings</a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy">&copy; 2026 White Mountain Education Association. All rights reserved.</div>
        <div class="footer-bottom-links">
          <a href="/privacy-policy/" class="on-dark">Privacy Policy</a>
          <a href="/terms-of-use/" class="on-dark">Terms of Use</a>
          <a href="/about-this-site/" class="on-dark">About This Site</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    var toggle = document.querySelector('.nav-toggle');
    var navLinks = document.getElementById('nav-links');
    if (toggle && navLinks) {
      toggle.addEventListener('click', function() {
        var open = navLinks.classList.toggle('nav-open');
        toggle.setAttribute('aria-expanded', open);
      });
    }
  </script>


</body>
</html>
