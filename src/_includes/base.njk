          <a href="https://www.agniyoga.org/" class="on-dark" target="_blank" rel="noopener">Agni Yoga Series<span class="sr-only"> (opens in new tab)</span></a>
          <a href="https://www.roerich.org/index.php" class="on-dark" target="_blank" rel="noopener">Roerich Paintings<span class="sr-only"> (opens in new tab)</span></a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-copy-group">
          <div class="footer-copy">&copy; 2026 White Mountain Education Association, Inc. All rights reserved.</div>
          <div class="footer-image-credit">Paintings by Nicholas Roerich used with permission of the <a href="https://www.roerichmuseum.org/" target="_blank" rel="noopener" class="on-dark">Nicholas Roerich Museum<span class="sr-only"> (opens in new tab)</span></a>, New York.</div>
        </div>
        <div class="footer-bottom-links">
          <a href="/privacy-policy/" class="on-dark">Privacy Policy</a>
          <a href="/terms-of-use/" class="on-dark">Terms of Use</a>
          <a href="/about-this-site/" class="on-dark">About This Site</a>
        </div>
      </div>
    </div>
  </footer>

  <script src="/assets/js/site.js?v=20260705" defer></script>


</body>
</html>
