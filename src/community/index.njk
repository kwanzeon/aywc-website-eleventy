---
layout: base.njk
title: "Community"
pageTitle: "Community—Agni Yoga World Community"
navPage: "community"
permalink: "/community/index.html"
metaDescription: "Agni Yoga study groups and organizations from around the world—find a group or join the global community."
---

<header aria-label="Page header">
  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label on-dark">Global Network</div>
      <h1 class="page-hero-title">Community</h1>
      <p class="page-hero-subtitle">Study groups and organizations from around the world—find a place to connect with the Living Ethics teachings.</p>
      <div class="page-hero-line"></div>
    </div>
  </div>
</header>

<main id="main-content" style="background:var(--bg);padding:4rem 3rem;">
  <div style="max-width:1200px;margin:0 auto;">

    <div class="community-filters">
      <div class="region-filter" role="group" aria-label="Filter by type">
        <button class="region-btn active" data-type="all" aria-pressed="true">All</button>
        <button class="region-btn" data-type="organization" aria-pressed="false">Organizations</button>
        <button class="region-btn" data-type="study-group" aria-pressed="false">Study Groups</button>
      </div>
      <div class="region-filter" role="group" aria-label="Filter by region">
        <button class="region-btn active" data-region="all" aria-pressed="true">All Regions</button>
        <button class="region-btn" data-region="Americas" aria-pressed="false">Americas</button>
        <button class="region-btn" data-region="Europe" aria-pressed="false">Europe</button>
        <button class="region-btn" data-region="Asia-Pacific" aria-pressed="false">Asia-Pacific</button>
        <button class="region-btn" data-region="Other" aria-pressed="false">Other</button>
      </div>
    </div>

    <p class="filter-status" aria-live="polite" aria-atomic="true" id="community-filter-status"></p>

    <h2 class="sr-only">Groups and Organizations Directory</h2>
    <div class="card-grid card-grid-2" id="community-list">
      {% for entry in collections.community %}
      <div class="card"
           data-types="{% for type in entry.data.types %}{{ type | lower | replace(' ', '-') }}{% if not loop.last %} {% endif %}{% endfor %}"
           data-region="{{ entry.data.region if entry.data.region else 'Other' }}"
           {% if entry.data.has_page %}data-has-page="true"{% endif %}>
        <div class="type-badges">
          {% for type in entry.data.types %}
          <span class="type-badge">{{ type }}</span>
          {% endfor %}
        </div>
        <h3>{{ entry.data.title }}</h3>
        <div class="group-card-meta">
          {% if entry.data.location %}<span class="group-card-location">{{ entry.data.location }}</span>{% endif %}
          {% if entry.data.established %}<span class="group-card-founded">Est. {{ entry.data.established }}</span>{% endif %}
        </div>
        <p class="card-desc">{{ entry.data.short_description }}</p>
        {% if entry.data.has_page %}
          <a class="group-card-link" href="/community/{{ entry.page.fileSlug }}/">View page &rarr;</a>
        {% elif entry.data.secondary_link %}
          <div class="card-links">
            <a class="group-card-link" href="{{ entry.data.website }}" target="_blank" rel="noopener" aria-label="{{ entry.data.link_text if entry.data.link_text else 'Visit website' }}—{{ entry.data.title }} (opens in new tab)">{{ entry.data.link_text if entry.data.link_text else "Visit website" }} &rarr;</a>
            <a class="group-card-link" href="{{ entry.data.secondary_link }}" target="_blank" rel="noopener" aria-label="{{ entry.data.secondary_link_text if entry.data.secondary_link_text else 'More' }}—{{ entry.data.title }} (opens in new tab)">{{ entry.data.secondary_link_text if entry.data.secondary_link_text else "More" }} &rarr;</a>
          </div>
        {% elif entry.data.website %}
          {% if entry.data.link_type == "email" %}
            <a class="group-card-link" href="{{ entry.data.website }}" aria-label="{{ entry.data.link_text if entry.data.link_text else 'Send email' }}—{{ entry.data.title }}">{{ entry.data.link_text if entry.data.link_text else "Send email" }} &rarr;</a>
          {% else %}
            <a class="group-card-link" href="{{ entry.data.website }}" target="_blank" rel="noopener" aria-label="{{ entry.data.link_text if entry.data.link_text else 'Visit website' }}—{{ entry.data.title }} (opens in new tab)">{{ entry.data.link_text if entry.data.link_text else "Visit website" }} &rarr;</a>
          {% endif %}
        {% endif %}
      </div>
      {% endfor %}
    </div>

    <div style="border-top:1px solid var(--border);margin-top:3rem;border-bottom:1px solid var(--border);">
      <button
        id="register-accordion-btn"
        aria-expanded="false"
        aria-controls="register-accordion-body"
        style="width:100%;display:flex;justify-content:space-between;align-items:center;background:none;border:none;padding:1.25rem 0;cursor:pointer;text-align:left;">
        <div>
          <div class="section-label" style="margin-bottom:0.25rem;">Not listed?</div>
          <span style="font-family:'Jost',sans-serif;font-size:1.2rem;font-weight:600;color:var(--text);">Add your group or organization</span>
        </div>
        <span id="register-accordion-icon" style="font-size:1.25rem;color:var(--accent);flex-shrink:0;margin-left:1rem;">&#43;</span>
      </button>

      <div id="register-accordion-body" hidden style="padding-bottom:2rem;max-width:600px;">
        <p style="color:var(--text-muted);font-size:1rem;line-height:1.75;margin-bottom:1.5rem;">Register your study group or organization so others can find you. We will review your submission and add it to the directory.</p>
        <form name="register-group" method="POST" action="/thank-you/" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="register-group" />
          <p hidden><label>Don't fill this out: <input name="bot-field" /></label></p>
          <div class="field">
            <label for="reg-name">Your name</label>
            <input type="text" id="reg-name" name="name" placeholder="Your name" required aria-required="true" />
          </div>
          <div class="field">
            <label for="reg-email">Your email</label>
            <input type="email" id="reg-email" name="email" placeholder="your@email.com" required aria-required="true" />
          </div>
          <div class="field">
            <label for="reg-group-name">Group or organization name</label>
            <input type="text" id="reg-group-name" name="group_name" placeholder="Name of your group or organization" required aria-required="true" />
          </div>
          <div class="field">
            <label for="reg-type">Type</label>
            <select id="reg-type" name="type">
              <option value="">Select one&hellip;</option>
              <option>Study Group</option>
              <option>Organization</option>
            </select>
          </div>
          <div class="field">
            <label for="reg-region">Region</label>
            <select id="reg-region" name="region">
              <option value="">Select one&hellip;</option>
              <option>Americas</option>
              <option>Europe</option>
              <option>Asia-Pacific</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="reg-website">Website (optional)</label>
            <input type="url" id="reg-website" name="website" placeholder="https://..." />
          </div>
          <div class="field">
            <label for="reg-message">Brief description</label>
            <textarea id="reg-message" name="message" placeholder="A brief description of your group or organization and its connection to the Agni Yoga Teaching&hellip;" required aria-required="true"></textarea>
          </div>
          <button class="btn btn-primary" type="submit">Submit Registration</button>
        </form>
      </div>
    </div>

  </div>
</main>

<script src="/assets/js/community.js?v=20260830" defer></script>
