---
pagination:
  data: collections.groups
  size: 1
  alias: group
  addAllPagesToCollections: true
permalink: "groups/{{ group.page.fileSlug }}/index.html"
layout: base.njk
navPage: "groups"
eleventyComputed:
  title: "{{ group.data.title }}"
  metaDescription: "{{ group.data.short_description if group.data.short_description else site.description }}"
---

<div class="page-hero">
  <div class="page-hero-inner">
    <nav class="page-hero-breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/" class="on-dark">Home</a></li>
        <li aria-hidden="true"><span>/</span></li>
        <li><a href="/groups/" class="on-dark">Study Groups</a></li>
        <li aria-hidden="true"><span>/</span></li>
        <li aria-current="page"><span>{{ group.data.title }}</span></li>
      </ol>
    </nav>
    <div class="section-label on-dark">Study Group</div>
    <h1 class="page-hero-title">{{ group.data.title }}</h1>
    {% if group.data.location or group.data.established %}
    <p class="page-hero-subtitle">{% if group.data.location %}{{ group.data.location }}{% endif %}{% if group.data.established %} &mdash; Est. {{ group.data.established }}{% endif %}</p>
    {% endif %}
    <div class="page-hero-line"></div>
  </div>
</div>

<main id="main-content" class="group-page-body">
  <div class="group-page-grid">

    <div class="group-content">
      {{ group.content | safe }}
    </div>

    <aside class="group-sidebar">

      <div class="sidebar-block">
        <div class="sidebar-block-title">Contact &amp; Visit</div>
        {% if group.data.address %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Address</span>
          <span class="sidebar-row-value">{{ group.data.address }}</span>
        </div>
        {% endif %}
        {% if group.data.phone %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Phone</span>
          <span class="sidebar-row-value">{{ group.data.phone }}</span>
        </div>
        {% endif %}
        {% if group.data.email %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Email</span>
          <span class="sidebar-row-value"><a href="mailto:{{ group.data.email }}">{{ group.data.email }}</a></span>
        </div>
        {% endif %}
        {% if group.data.website %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Website</span>
          <span class="sidebar-row-value"><a href="{{ group.data.website }}" target="_blank" rel="noopener">{{ group.data.website | replace("https://", "") | replace("http://", "") }}</a></span>
        </div>
        {% endif %}
        {% if group.data.website %}
        <a class="sidebar-visit on-dark" href="{{ group.data.website }}" target="_blank" rel="noopener">Visit Official Website &rarr;</a>
        {% endif %}
      </div>

      {% if group.data.visiting_hours %}
      <div class="sidebar-block">
        <div class="sidebar-block-title">Visiting Hours</div>
        {% for row in group.data.visiting_hours %}
        <div class="hours-row">
          <span class="days">{{ row.days }}</span>
          <span class="time">{{ row.hours }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {% if group.data.extra_title %}
      <div class="sidebar-block">
        <div class="sidebar-block-title">{{ group.data.extra_title }}</div>
        {% if group.data.extra_body %}<p style="color:var(--text-muted);font-size:1rem;font-weight:400;line-height:1.6;margin-bottom:0.5rem;">{{ group.data.extra_body }}</p>{% endif %}
        {% if group.data.extra_link %}
        <a class="sidebar-visit on-dark" href="{{ group.data.extra_link }}" target="_blank" rel="noopener">{{ group.data.extra_link_text if group.data.extra_link_text else "Visit →" }}</a>
        {% endif %}
      </div>
      {% endif %}

      <div class="sidebar-block">
        <div class="sidebar-block-title">Organization Details</div>
        {% if group.data.established %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Founded</span>
          <span class="sidebar-row-value">{{ group.data.established }}{% if group.data.location %}, {{ group.data.location }}{% endif %}</span>
        </div>
        {% endif %}
        {% if group.data.founder %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Founder</span>
          <span class="sidebar-row-value">{{ group.data.founder }}</span>
        </div>
        {% endif %}
        {% if group.data.tax_status %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Tax status</span>
          <span class="sidebar-row-value">{{ group.data.tax_status }}</span>
        </div>
        {% endif %}
        {% if group.data.membership %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Membership</span>
          <span class="sidebar-row-value">{{ group.data.membership }}</span>
        </div>
        {% endif %}
        {% if group.data.fees %}
        <div class="sidebar-row">
          <span class="sidebar-row-label">Fees</span>
          <span class="sidebar-row-value">{{ group.data.fees }}</span>
        </div>
        {% endif %}
      </div>

    </aside>
  </div>
</main>
