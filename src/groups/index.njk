---
layout: base.njk
title: "Study Groups"
navPage: "groups"
permalink: "/groups/index.html"
metaDescription: "Find a study group for the Agni Yoga (Living Ethics) teachings near you, or register your own group in the global directory."
---

<div class="page-hero">
  <div class="page-hero-inner">
    <div class="section-label on-dark">Directory</div>
    <h1 class="page-hero-title">Study Groups</h1>
    <p class="page-hero-subtitle">Independent groups from around the world meet regularly to study the teachings. Find a group near you, or register your own.</p>
    <div class="page-hero-line"></div>
  </div>
</div>

<main id="main-content" style="background:var(--bg);padding:4rem 3rem;">
  <div style="max-width:1200px;margin:0 auto;">

    <div class="region-filter" role="group" aria-label="Filter by region">
      <button class="region-btn active" data-region="All" aria-pressed="true">All</button>
      <button class="region-btn" data-region="Americas" aria-pressed="false">Americas</button>
      <button class="region-btn" data-region="Europe" aria-pressed="false">Europe</button>
      <button class="region-btn" data-region="Asia-Pacific" aria-pressed="false">Asia-Pacific</button>
    </div>

    <h2 class="sr-only">Study groups list</h2>
    <p class="sr-only" aria-live="polite" aria-atomic="true" id="groups-filter-status"></p>

    <div class="card-grid card-grid-2" id="groups-list">
      {% for group in collections.groups %}
      <div class="card" data-region="{{ group.data.region if group.data.region else 'Other' }}">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
          <h3>{{ group.data.title }}</h3>
          {% if group.data.format %}<span class="group-card-format">{{ group.data.format }}</span>{% endif %}
        </div>
        <div class="group-card-meta">
          <span class="group-card-location">{{ group.data.location }}</span>
          {% if group.data.established %}<span class="group-card-founded">Est. {{ group.data.established }}</span>{% endif %}
        </div>
        <p>{{ group.data.short_description }}</p>
        <a class="group-card-link" href="/groups/{{ group.page.fileSlug }}/">View group page &rarr;</a>
      </div>
      {% endfor %}

      {# Placeholder cards for unlisted groups #}
      <div class="card" data-region="Europe">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
          <h3>Friends of the Roerichs</h3>
          <span class="group-card-format">In-person</span>
        </div>
        <div class="group-card-meta">
          <span class="group-card-location">London, UK</span>
        </div>
        <p style="color:var(--text-muted);font-size:0.87rem;font-weight:300;line-height:1.75;">Monthly gatherings exploring the teachings alongside Roerich's art and the Banner of Peace movement.</p>
      </div>
      <div class="card" data-region="Europe">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
          <h3>Roerich Cultural Center</h3>
          <span class="group-card-format">In-person</span>
        </div>
        <div class="group-card-meta">
          <span class="group-card-location">Moscow, Russia</span>
        </div>
        <p style="color:var(--text-muted);font-size:0.87rem;font-weight:300;line-height:1.75;">Active research and study community with a library, lecture program, and regular seminars open to all.</p>
      </div>
      <div class="card" data-region="Asia-Pacific">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
          <h3>Living Ethics Circle</h3>
          <span class="group-card-format">Online</span>
        </div>
        <div class="group-card-meta">
          <span class="group-card-location">Sydney, Australia</span>
        </div>
        <p style="color:var(--text-muted);font-size:0.87rem;font-weight:300;line-height:1.75;">A small group meeting fortnightly via video call, welcoming students from Australia and New Zealand.</p>
      </div>
      <div class="card" data-region="Asia-Pacific">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
          <h3>Himalayan Heritage Group</h3>
          <span class="group-card-format">In-person &amp; Online</span>
        </div>
        <div class="group-card-meta">
          <span class="group-card-location">Bangalore, India</span>
        </div>
        <p style="color:var(--text-muted);font-size:0.87rem;font-weight:300;line-height:1.75;">Connecting Indian students with the trans-Himalayan wisdom tradition shared in the Agni Yoga books.</p>
      </div>
    </div>

    <div class="register-cta">
      <div>
        <div class="register-cta-label">Don't see yours?</div>
        <div class="register-cta-title">Register your study group</div>
        <div class="register-cta-body">Add your group to the directory so students in your area can find you.</div>
      </div>
      <a class="btn btn-primary" href="/join/">Register your group &rarr;</a>
    </div>

  </div>
</main>

<script>
(function() {
  var btns = document.querySelectorAll('.region-btn');
  var cards = document.querySelectorAll('#groups-list .card');
  btns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var region = this.dataset.region;
      btns.forEach(function(b) { b.classList.remove('active'); b.setAttribute('aria-pressed', 'false'); });
      this.classList.add('active');
      this.setAttribute('aria-pressed', 'true');
      var visible = 0;
      cards.forEach(function(card) {
        var show = region === 'All' || card.dataset.region === region;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      var status = document.getElementById('groups-filter-status');
      if (status) status.textContent = region === 'All' ? 'Showing all study groups.' : 'Showing ' + visible + ' group' + (visible !== 1 ? 's' : '') + ' in ' + region + '.';
    });
  });
})();
</script>
