---
layout: base.njk
title: "About Agni Yoga"
navPage: "about"
permalink: "/about/index.html"
metaDescription: "Learn about Agni Yoga (Living Ethics), the spiritual Teaching transmitted through Helena Roerich, and the principles of beauty, service, and striving."
---

<header aria-label="Page header">
  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label on-dark">{{ about.hero.label }}</div>
      <h1 class="page-hero-title">{{ about.hero.title }}</h1>
      <p class="page-hero-subtitle">{{ about.hero.subtitle }}</p>
      <div class="page-hero-line"></div>
    </div>
  </div>
</header>

<main id="main-content">
  <section id="teachings" style="background:var(--bg);padding:5rem 3rem;border-bottom:1px solid var(--border);">
    <div style="max-width:760px;margin:0 auto;">
      <div class="section-label">{{ about.overview.label }}</div>
      <h2 class="section-heading" style="margin-bottom:0.4rem;">{{ about.overview.heading }}</h2>
      {% if about.overview.author %}
      <p style="font-family:'Cinzel',serif;font-weight:400;font-size:0.95rem;color:var(--accent);letter-spacing:0.12em;margin-bottom:0.2rem;">{{ about.overview.author }}</p>
      <p style="font-family:'Jost',sans-serif;font-size:0.85rem;color:var(--text-muted);margin-bottom:2rem;">{{ about.overview.author_title }}</p>
      {% endif %}
      {% for paragraph in about.overview.intro %}
      {# | safe is intentional: intro paragraphs use <em> for book-title italics (AYWC-165).
         CMS hint in admin/config.yml documents this to editors. #}
      <p style="color:var(--text-muted);font-size:1rem;line-height:1.85;font-weight:400;margin-bottom:1.2rem;">{{ paragraph | safe }}</p>
      {% endfor %}
      {% for pillar in about.overview.pillars %}
      <div style="margin-top:2.5rem;">
        <h3 style="font-family:'Cinzel',serif;font-weight:400;font-size:1.15rem;color:var(--accent);margin-bottom:0.75rem;">{{ pillar.title }}</h3>
        {% for paragraph in pillar.body %}
        <p style="color:var(--text-muted);font-size:1rem;line-height:1.85;font-weight:400;{% if not loop.last %}margin-bottom:1rem;{% endif %}">{{ paragraph }}</p>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </section>

  <section id="roerich" class="roerich-section">
    <div class="roerich-inner">
      <div class="section-label on-dark">{{ about.roerich.label }}</div>
      <h2 class="section-heading on-dark" style="margin-bottom:3rem;">{{ about.roerich.heading }}</h2>
      <figure class="roerich-feature">
        <img src="{{ about.roerich.image.src }}" alt="{{ about.roerich.image.alt }}" width="{{ about.roerich.image.width }}" height="{{ about.roerich.image.height }}" loading="lazy" decoding="async" />
        <figcaption>{{ about.roerich.image.caption }}</figcaption>
      </figure>
      <div class="two-col-grid" style="gap:4rem;">
        {% for column in about.roerich.columns %}
        <div>
          {% for paragraph in column.body %}
          <p class="about-body">{{ paragraph }}</p>
          {% endfor %}
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section style="background:var(--bg);padding:5rem 3rem;border-top:1px solid var(--border);">
    <div style="max-width:760px;margin:0 auto;text-align:center;">
      <div class="section-label" style="text-align:center;">{{ about.community.label }}</div>
      <h2 class="section-heading" style="margin-bottom:1.5rem;">{{ about.community.heading }}</h2>
      <p style="color:var(--text-muted);font-size:1rem;line-height:1.85;font-weight:400;margin-bottom:2rem;">{{ about.community.body }}</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        {% for button in about.community.buttons %}
        <a class="btn btn-{{ button.style }}" href="{{ button.url }}">{{ button.label }}</a>
        {% endfor %}
      </div>
    </div>
  </section>
</main>
