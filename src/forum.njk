---
layout: base.njk
title: "Forum"
navPage: "forum"
permalink: "/forum/index.html"
metaDescription: "Join the Agni Yoga World Community forum — a place for students of the Living Ethics Teachings to connect, share, and study together."
---

<header aria-label="Page header">
  <div class="page-hero">
    <div class="page-hero-inner">
      <div class="section-label on-dark">Community</div>
      <h1 class="page-hero-title">Forum</h1>
      <p class="page-hero-subtitle">A gathering place for students of the Living Ethics Teachings to connect, share, and&nbsp;study together.</p>
      <div class="page-hero-line"></div>
    </div>
  </div>
</header>

<main id="main-content" style="background:var(--bg);padding:4rem 3rem;">
  <div style="max-width:760px;margin:0 auto;">

    <div style="text-align:center;margin-bottom:3.5rem;">
      <a class="btn btn-primary" href="https://community.solarfuturenow.com/" target="_blank" rel="noopener" style="font-size:1.05rem;padding:0.9rem 2.5rem;">Go to the Forum &rarr;<span class="sr-only"> (opens in new tab)</span></a>
    </div>

    <section aria-labelledby="recent-discussions-heading" style="margin-bottom:3.5rem;">
      <div class="section-label" style="margin-bottom:0.5rem;">Live from the Forum</div>
      <h2 id="recent-discussions-heading" class="section-heading" style="margin-bottom:1.5rem;">Recent Discussions</h2>
      <div id="forum-topics">
        <p style="color:var(--text-muted);font-size:0.95rem;">Loading recent discussions&hellip;</p>
      </div>
    </section>

    <div style="border-top:1px solid var(--border);padding-top:3rem;">

    <div style="border-top:1px solid var(--border);padding-top:3rem;">
      <div class="section-label" style="margin-bottom:0.5rem;">New Here?</div>
      <h2 class="section-heading" style="margin-bottom:2rem;">How to create your account</h2>

      {% set steps = [
        { n: "1", heading: "Go to the forum", body: "Click the button above, or go directly to <a href=\"https://community.solarfuturenow.com/\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent);\">community.solarfuturenow.com</a>." },
        { n: "2", heading: "Click &ldquo;Sign Up&rdquo;", body: "Click the <strong>Sign Up</strong> button in the upper right corner of the forum page." },
        { n: "3", heading: "Enter your details", body: "Fill in your email address, a username (your public display name), and a password of at least 10 characters." },
        { n: "4", heading: "Confirm your email", body: "Check your inbox for a confirmation email and click the link inside to activate your account. If it doesn&rsquo;t arrive within a few minutes, check your spam folder." },
        { n: "5", heading: "Await approval", body: "New accounts are reviewed before they can post. You will receive an email once your account has been approved, usually within a day or two." },
        { n: "6", heading: "You&rsquo;re in", body: "Once approved, you can read and post in any open topic. You may also add a short bio and profile photo under your account preferences." }
      ] %}

      {% for step in steps %}
      <div style="display:flex;gap:1.5rem;margin-bottom:2rem;align-items:flex-start;">
        <div style="flex-shrink:0;width:2rem;height:2rem;border-radius:50%;background:var(--accent);color:#fff;display:flex;align-items:center;justify-content:center;font-size:0.75rem;font-weight:600;font-family:'Jost',sans-serif;margin-top:0.1rem;">{{ step.n }}</div>
        <div>
          <div style="font-family:'Jost',sans-serif;font-weight:600;color:var(--text);margin-bottom:0.3rem;">{{ step.heading | safe }}</div>
          <p style="color:var(--text-muted);font-size:1rem;font-weight:400;line-height:1.75;margin:0;">{{ step.body | safe }}</p>
        </div>
      </div>
      {% endfor %}

      <p style="color:var(--text-muted);font-size:0.95rem;line-height:1.75;margin-top:2.5rem;border-top:1px solid var(--border);padding-top:1.5rem;">
        Having trouble? Contact us at <a href="mailto:staff@wmea-world.org" style="color:var(--accent);">staff@wmea-world.org</a> and we will help you get set up.
      </p>
    </div>

  </div>
</main>

<script>
(function() {
  var container = document.getElementById('forum-topics');
  if (!container) return;
  fetch('https://community.solarfuturenow.com/latest.json?per_page=8')
    .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
    .then(function(data) {
      var topics = (data.topic_list && data.topic_list.topics) || [];
      if (!topics.length) { renderFallback(); return; }
      var html = '<ul style="list-style:none;padding:0;margin:0;">';
      topics.forEach(function(t) {
        var url = 'https://community.solarfuturenow.com/t/' + t.slug + '/' + t.id;
        var replies = t.reply_count || 0;
        var replyText = replies === 1 ? '1 reply' : replies + ' replies';
        var date = t.last_posted_at ? new Date(t.last_posted_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
        html += '<li style="border-bottom:1px solid var(--border);padding:0.9rem 0;">'
          + '<a href="' + url + '" target="_blank" rel="noopener" style="color:var(--text);font-family:\'Jost\',sans-serif;font-weight:500;font-size:1rem;display:block;margin-bottom:0.25rem;">' + t.title + '<span class="sr-only"> (opens in new tab)</span></a>'
          + '<span style="color:var(--text-muted);font-size:0.8rem;">' + replyText + (date ? ' &middot; ' + date : '') + '</span>'
          + '</li>';
      });
      html += '</ul>';
      html += '<p style="margin-top:1.2rem;"><a href="https://community.solarfuturenow.com/" target="_blank" rel="noopener" style="color:var(--accent);font-size:0.9rem;font-weight:500;">See all discussions &rarr;<span class="sr-only"> (opens in new tab)</span></a></p>';
      container.innerHTML = html;
    })
    .catch(renderFallback);

  function renderFallback() {
    container.innerHTML = '<p style="color:var(--text-muted);font-size:0.95rem;">Visit the forum to see the latest discussions.</p>';
  }
})();
</script>
