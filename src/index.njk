---
layout: base.njk
pageTitle: "Agni Yoga World Community — Living Ethics Teaching & Study Groups Worldwide"
heroTransparent: true
---

<section id="hero" aria-label="Hero">
  <div class="hero-banner">
    <h1 class="sr-only">Agni Yoga World Community</h1>
    <img src="/assets/banner.png" alt="Agni Yoga World Community — banner showing the Maitreya seal against Himalayan mountains and starlit sky" />
  </div>
  <div class="hero-intro">
    <div class="hero-intro-inner">
      <div>
        <div class="hero-operator">White Mountain Education Association</div>
        <p class="hero-tagline">A global gathering place for students and groups working with the Living Ethics teachings — sharing knowledge, community, and the path of conscious evolution.</p>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/about/">Explore the Path</a>
        <a class="btn btn-outline-dark" href="/join/">Join the Community</a>
      </div>
    </div>
  </div>
</section>

<main id="main-content">

  <section id="updates" aria-labelledby="updates-heading" class="updates-section">
    <div class="section-inner">
      <div class="updates-header">
        <div>
          <div class="section-label on-dark">New &amp; Noteworthy</div>
          <h2 id="updates-heading" class="section-heading on-dark">Recent Updates</h2>
          <p class="updates-intro">Recently added events, conferences, publications, and community announcements from across the Agni Yoga world.</p>
        </div>
        <a href="/news/" class="updates-all-link on-dark">All updates &amp; events &rarr;</a>
      </div>
      <div class="updates-grid">
        {% for item in collections.news | limit(3) %}
        <article class="update-card{% if loop.first %} update-card-featured{% endif %}">
          <span class="update-tag">{{ item.data.tag }}</span>
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.summary }}</p>
          <div class="update-meta">
            {{ item.data.date_label if item.data.date_label }}
            {% if item.data.link %} &middot; <a href="{{ item.data.link }}" target="_blank" rel="noopener">{{ item.data.link_text if item.data.link_text else "Details →" }}</a>{% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="about" aria-labelledby="about-heading" class="about-section">
    <div class="section-inner">
      <div class="about-grid">
        <div>
          <div class="section-label on-dark">The Teaching</div>
          <h2 id="about-heading" class="section-heading on-dark">About Agni Yoga</h2>
          <div class="about-divider"></div>
          <p class="about-body">Agni Yoga, also known as Living Ethics, is a spiritual teaching transmitted through Helena Roerich. It offers practical guidance for the conscious development of the human spirit — not as retreat from the world, but toward its transformation through beauty, service, and striving.</p>
          <p class="about-body">The series comprises fourteen books of wisdom, touching on ethics, cosmology, the nature of consciousness, and the path of evolution. Central is the principle of Maitreya — universal brotherhood and goodwill.</p>
          <a class="btn btn-primary" href="/about/">Learn about the teachings &rarr;</a>
        </div>
        <div>
          {% for item in [["Beauty", "Consciously created in daily life"], ["The Heart", "Awakened through striving and love"], ["Service", "Rendered as an act of spiritual will"], ["Striving", "Toward higher ideals, always"]] %}
          <div class="about-attr">
            <div class="about-attr-title">{{ item[0] }}</div>
            <div class="about-attr-sub">{{ item[1] }}</div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section id="groups" aria-labelledby="groups-heading" class="groups-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <div class="section-label">Directory</div>
          <h2 id="groups-heading" class="section-heading">Study Groups</h2>
        </div>
        <a href="/groups/" class="section-all-link">Full directory &rarr;</a>
      </div>
      <div class="card-grid card-grid-2">
        {% for group in collections.groups | limit(4) %}
        <a class="card card-on-alt" href="/groups/{{ group.page.fileSlug }}/">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:0.5rem;gap:1rem;">
            <h3>{{ group.data.title }}</h3>
            {% if group.data.format %}<span class="group-card-format">{{ group.data.format }}</span>{% endif %}
          </div>
          <div class="group-card-meta">
            <span class="group-card-location">{{ group.data.location }}</span>
            {% if group.data.established %}<span class="group-card-founded">Est. {{ group.data.established }}</span>{% endif %}
          </div>
          <p>{{ group.data.short_description }}</p>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="resources" aria-labelledby="resources-heading" class="resources-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <div class="section-label">Open Access</div>
          <h2 id="resources-heading" class="section-heading">Resources</h2>
        </div>
        <a href="/resources/" class="section-all-link">All resources &rarr;</a>
      </div>
      <div class="card-grid card-grid-3">
        {% for resource in collections.resources | limit(6) %}
        <{% if resource.data.link %}a href="{{ resource.data.link }}"{% if resource.data.external %} target="_blank" rel="noopener"{% endif %}{% else %}div{% endif %} class="card">
          <div class="accent-line"></div>
          <h3>{{ resource.data.title }}</h3>
          <p>{{ resource.data.description }}</p>
        </{% if resource.data.link %}a{% else %}div{% endif %}>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="join" aria-labelledby="join-heading" class="join-section">
    <div class="section-inner">
      <div class="join-grid">
        <div>
          <div class="section-label on-dark">Open to All</div>
          <h2 id="join-heading" class="join-heading">Join &amp; Connect</h2>
          <p class="join-body">The Agni Yoga World Community is volunteer-run with no formal membership or hierarchy. Whether you are new to the teachings or an experienced student, you are welcome here.</p>
          <a class="btn btn-primary" href="/join/">Get in touch &rarr;</a>
        </div>
        <div class="join-divider">
          {% for item in ["Connect with an existing local study group", "Register your own group in the directory", "Contribute resources, translations, or articles", "Share news of events in your region", "Volunteer to help maintain this site"] %}
          <div class="join-item">
            <span class="join-item-bullet">✦</span>
            <span class="join-item-text">{{ item }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

</main>
