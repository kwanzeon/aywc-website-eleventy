---
layout: base.njk
pageTitle: "Agni Yoga World Community — Living Ethics Teaching & Study Groups Worldwide"
navPage: "home"
---

<main id="main-content">

<section id="hero" aria-label="Hero">
  <div class="hero-banner">
    <h1 class="sr-only">Agni Yoga World Community</h1>
    <picture>
      <source type="image/avif" srcset="/assets/images/banner/banner-400.avif 400w, /assets/images/banner/banner-750.avif 750w, /assets/images/banner/banner-1123.avif 1123w" sizes="100vw">
      <source type="image/webp" srcset="/assets/images/banner/banner-400.webp 400w, /assets/images/banner/banner-750.webp 750w, /assets/images/banner/banner-1123.webp 1123w" sizes="100vw">
      <img src="/assets/images/banner/banner-1123.jpg" srcset="/assets/images/banner/banner-400.jpg 400w, /assets/images/banner/banner-750.jpg 750w, /assets/images/banner/banner-1123.jpg 1123w" sizes="100vw" width="1123" height="239" alt="Agni Yoga World Community — banner showing the Maitreya seal against Himalayan mountains and starlit sky" />
    </picture>
  </div>
  <div class="hero-intro">
    <div class="hero-intro-inner">
      <div>
        <div class="hero-operator">Agni Yoga World Community</div>
        <p class="hero-tagline">A global gathering place for students and groups working with the Living Ethics teachings — sharing knowledge, community, and the path of conscious evolution.</p>
      </div>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/what-is-agni-yoga/">Start Learning Agni Yoga</a>
        <a class="btn btn-outline-dark" href="/community/">Find a Study Group</a>
      </div>
    </div>
  </div>
</section>

  <div class="bop-divider" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="28" height="28" fill="currentColor">
      <circle cx="20" cy="20" r="18.5" fill="none" stroke="currentColor" stroke-width="1.25"/>
      <circle cx="20" cy="10.5" r="4"/>
      <circle cx="12" cy="26" r="4"/>
      <circle cx="28" cy="26" r="4"/>
    </svg>
  </div>

  <section class="seed-thought-section" data-seed-thought data-seed-thought-built="{{ seedThought.dateKey }}" aria-labelledby="seed-thought-title">
    <div class="section-inner">
      <div class="seed-thought-card">
        <span class="seed-thought-label">Daily Planting</span>
        <h2 id="seed-thought-title" data-seed-thought-date>Agni Yoga Seed Thought for {{ seedThought.label }}</h2>
        <div class="seed-thought-content" data-seed-thought-content aria-live="polite">
          {{ seedThought.html | safe }}
        </div>
      </div>
    </div>
  </section>

  <section id="about" aria-labelledby="about-heading" class="about-section">
    <div class="section-inner">
      <div class="about-grid">
        <div>
          <div class="section-label on-dark">{{ home.agni_yoga_section.label }}</div>
          <h2 id="about-heading" class="section-heading on-dark">{{ home.agni_yoga_section.heading }}</h2>
          <div class="about-divider"></div>
          {% for paragraph in home.agni_yoga_section.body %}
          <p class="about-body">{{ paragraph }}</p>
          {% endfor %}
        </div>
        <div>
          {% if home.agni_yoga_section.attributes_heading %}
          <h3 class="about-attr-heading">{{ home.agni_yoga_section.attributes_heading }}</h3>
          {% endif %}
          {% for item in home.agni_yoga_section.attributes %}
          <div class="about-attr">
            <h4 class="about-attr-title"><span aria-hidden="true">◆ </span>{{ item.title }}</h4>
          </div>
          {% endfor %}
          <a class="btn btn-primary" href="{{ home.agni_yoga_section.cta_url }}" style="margin-top:1.5rem;">{{ home.agni_yoga_section.cta_label }}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="forum-cta" aria-labelledby="forum-cta-heading" class="forum-cta-section">
    <div class="section-inner">
      <div class="forum-cta-grid">
        <div class="forum-cta-text">
          <div class="section-label on-dark">Open Discussion</div>
          <h2 id="forum-cta-heading" class="forum-cta-heading">The conversation is ongoing&nbsp;.&nbsp;.&nbsp;.</h2>
          <p class="forum-cta-body">Students from across the world gather to study, question, and support one another. The forum is open to all sincere seekers.</p>
          <a class="btn btn-outline-dark" href="/forum/">Join the conversation &rarr;</a>
        </div>
        <div class="forum-cta-topics" aria-label="Recent forum discussions">
          <div class="section-label on-dark" style="margin-bottom:1rem;">Recent Discussions</div>
          <div id="forum-topics">
            <p style="color:var(--dark-muted);font-size:0.95rem;">Visit <a href="/forum/" style="color:var(--accent-on-dark);text-decoration:underline;text-underline-offset:2px;">the forum</a> to see the latest discussions.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="start-here" aria-labelledby="start-here-heading" class="start-section">
    <div class="section-inner">
      <div class="start-callout">
        <div class="section-label">New to Agni Yoga?</div>
        <h2 id="start-here-heading" class="section-heading">You Don&rsquo;t Have to Begin Alone</h2>
        <p class="start-callout-body">However you found your way here, others have walked this path before you and are walking it now. Find a study group to learn alongside them, or read the introduction first if you&rsquo;d like an overview.</p>
        <div class="start-callout-ctas">
          <a class="btn btn-primary" href="/community/">Find a Study Group</a>
          <a class="start-callout-link" href="/what-is-agni-yoga/">Read the introduction first &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section id="resources" aria-labelledby="resources-heading" class="resources-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <div class="section-label">Open Access</div>
          <h2 id="resources-heading" class="section-heading">Resources</h2>
        </div>
        <a href="/resources/" class="section-all-link">All resources &rarr;</a>
      </div>
      <div class="card-grid card-grid-3">
        {% for resource in collections.resources | limit(6) %}
        <{% if resource.data.link %}a href="{{ resource.data.link }}"{% if resource.data.external %} target="_blank" rel="noopener"{% endif %}{% else %}div{% endif %} class="card">
          <div class="accent-line"></div>
          <h3>{{ resource.data.title }}</h3>
          <p>{{ resource.data.description }}</p>
        </{% if resource.data.link %}a{% else %}div{% endif %}>
        {% endfor %}
      </div>
    </div>
  </section>

  <section id="updates" aria-labelledby="updates-heading" class="updates-section">
    <div class="section-inner">
      <div class="updates-header">
        <div>
          <div class="section-label on-dark">News &amp; Events</div>
          <h2 id="updates-heading" class="section-heading on-dark">Community Updates</h2>
          <p class="updates-intro">Events, publications, and announcements from across the Agni Yoga world.</p>
        </div>
        <a href="/news/" class="updates-all-link on-dark">View all news &amp; events &rarr;</a>
      </div>
      <div class="updates-grid">
        {% for item in collections.news | limit(3) %}
        <article class="update-card{% if loop.first %} update-card-featured{% endif %}">
          <span class="update-tag">{{ item.data.tag }}</span>
          <h3>{{ item.data.title }}</h3>
          <p>{{ item.data.summary }}</p>
          <div class="update-meta">
            {% if item.data.date_label %}<time datetime="{{ item.data.date | htmlDateString }}">{{ item.data.date_label }}</time>{% endif %}
            {% if item.data.link %} &middot; <a href="{{ item.data.link }}" target="_blank" rel="noopener">{{ item.data.link_text if item.data.link_text else "Details →" }}</a>{% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

</main>

<script src="/assets/js/seed-thoughts.js?v=20260704" defer></script>
<script src="/assets/js/forum.js" defer></script>
